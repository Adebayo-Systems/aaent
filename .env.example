# Paystack Public Key for Frontend Checkout (Safe for browser)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack Secret / Private Key (ONLY for Serverless APIs / Backend — NEVER expose in client bundles)
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site Access Password (Backend / Serverless only — NEVER exposed to browser client)
SITE_ACCESS_PASSWORD=your_password_here